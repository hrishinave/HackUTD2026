    {
      "contract_id": "C-01",
      "requirement": {
        "id": "R-01",
        "statement": "Every claim that needs prior authorization records the authorization number in its own field.",
        "feature": "Claim submission"
      },
      "role": "billing_clerk",
      "signal": "field_usage",
      "expectations": [
        {
          "metric_id": "pa_field_fill_rate",
          "description": "Share of prior-auth claims with the prior-auth field filled",
          "template": "field_fill_rate",
          "params": {
            "event": "claim_submitted",
            "flag": "prior_auth_number_filled"
          },
          "comparator": ">=",
          "target": 0.95,
          "unit": "share",
          "tolerance": 0.05
        },
        {
          "metric_id": "pa_in_notes_rate",
          "description": "Share of prior-auth claims with an auth number typed into notes",
          "template": "detector_rate",
          "params": {
            "event": "claim_submitted",
            "tag": "auth_number"
          },
          "comparator": "<=",
          "target": 0.05,
          "unit": "share",
          "tolerance": 0.05
        }
      ],
      "learning_period_weeks": 2,
      "status": "broken",
      "first_breach_week": 4,
      "early_warning": false,
      "severity": 5.4,
      "recovered": false,
